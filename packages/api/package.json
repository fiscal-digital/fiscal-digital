{
  "name": "@fiscal-digital/api",
  "version": "0.1.0",
  "private": true,
  "description": "Lambda API pública — alertas por cidade, secretaria e fornecedor",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js --external:@aws-sdk/*",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@aws-lambda-powertools/logger": "^2.35.0",
    "@aws-sdk/client-dynamodb": "^3.1129.0",
    "@aws-sdk/client-s3": "^3.1129.0",
    "@aws-sdk/lib-dynamodb": "^3.1129.0",
    "@fiscal-digital/engine": "*",
    "@fiscal-digital/contracts": "*"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.163",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.2",
    "jest": "^30.5.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.0"
  }
}
